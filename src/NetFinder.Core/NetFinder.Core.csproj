<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NetFinder.Core</RootNamespace>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\oui.txt.gz" LogicalName="oui.txt.gz" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="NetFinder.Core.Lang.%(Filename).json" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>
</Project>
